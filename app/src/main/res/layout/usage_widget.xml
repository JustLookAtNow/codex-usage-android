<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:clipToOutline="true" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background" android:layoutDirection="ltr">
    <FrameLayout android:id="@+id/widget_glass_blur" android:layout_width="match_parent" android:layout_height="match_parent" android:tag="OplusBlurBg" android:visibility="gone" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/widget_low_quota_glow" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:importantForAccessibility="no" android:background="@drawable/widget_low_quota_glow" />
    <FrameLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:layoutDirection="ltr" android:baselineAligned="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_widget_gpt" android:importantForAccessibility="yes" android:id="@+id/widget_icon_gpt" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:layout_marginStart="8dp" android:text="@string/widget_title" android:textStyle="bold" android:id="@+id/widget_static_text_1" />
                <ImageView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:id="@+id/widget_status" android:ellipsize="end" android:layout_marginEnd="3dp" android:visibility="gone" />
                <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_widget_refresh" android:importantForAccessibility="yes" android:padding="4dp" android:contentDescription="@string/widget_refresh_description" android:visibility="invisible" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:orientation="horizontal" android:baselineAligned="false">
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:baselineAligned="false">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_widget_clock" android:importantForAccessibility="no" android:id="@+id/widget_icon_clock" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:layout_marginStart="5dp" android:text="@string/widget_period_5h" android:textStyle="bold" android:id="@+id/widget_static_text_2" />
                    </LinearLayout>
                    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                        <ImageView android:id="@+id/widget_primary_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:visibility="gone" />
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:textSize="40sp" android:textColor="@color/widget_primary" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:id="@+id/widget_primary_value" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="44sp" android:autoSizeStepGranularity="1sp" android:text="@string/widget_unknown" android:textStyle="bold" />
                    </FrameLayout>
                    <ImageView android:id="@+id/widget_primary_progress" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="3dp" android:layout_marginBottom="5dp" android:visibility="visible" android:scaleType="fitXY" android:importantForAccessibility="no" />
                    <TextView android:layout_width="match_parent" android:layout_height="22dp" android:textSize="12sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:id="@+id/widget_primary_countdown" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:text="@string/widget_unknown" android:textStyle="bold" />
                </LinearLayout>
                <ImageView android:id="@+id/widget_divider_1" android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/widget_divider" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:baselineAligned="false">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_widget_calendar" android:importantForAccessibility="no" android:id="@+id/widget_icon_calendar" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:layout_marginStart="5dp" android:text="@string/widget_period_weekly" android:textStyle="bold" android:id="@+id/widget_static_text_3" />
                    </LinearLayout>
                    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                        <ImageView android:id="@+id/widget_weekly_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:visibility="gone" />
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:textSize="40sp" android:textColor="@color/widget_weekly" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:id="@+id/widget_weekly_value" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="44sp" android:autoSizeStepGranularity="1sp" android:text="@string/widget_unknown" android:textStyle="bold" />
                    </FrameLayout>
                    <ImageView android:id="@+id/widget_weekly_progress" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="3dp" android:layout_marginBottom="5dp" android:visibility="visible" android:scaleType="fitXY" android:importantForAccessibility="no" />
                    <TextView android:layout_width="match_parent" android:layout_height="22dp" android:textSize="12sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:id="@+id/widget_weekly_countdown" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="12sp" android:autoSizeStepGranularity="1sp" android:text="@string/widget_unknown" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <TextView android:id="@+id/widget_reset_count" android:layout_width="wrap_content" android:layout_height="12dp" android:layout_gravity="bottom|end" android:layout_marginBottom="2dp" android:layout_marginEnd="14dp" android:gravity="center" android:textSize="9sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="1sp" />
    <ImageView android:id="@+id/widget_loading_overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no" />
    <FrameLayout android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end" android:contentDescription="@string/widget_refresh_description" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="17dp" android:paddingBottom="11dp">
        <ImageView android:id="@+id/widget_refresh_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_widget_refresh" android:importantForAccessibility="no" />
        <FrameLayout android:id="@+id/widget_refresh_animation" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
    </FrameLayout>
</FrameLayout>
