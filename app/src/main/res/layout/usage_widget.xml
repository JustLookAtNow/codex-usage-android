<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/widget_title" android:textColor="#47675C" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="@string/widget_refresh" android:contentDescription="@string/widget_refresh_description" android:textColor="#087F6D" android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_usage" android:layout_width="90dp" android:layout_height="wrap_content" android:text="@string/widget_empty" android:textSize="14sp" android:lineSpacingExtra="4dp" android:textStyle="bold" android:textColor="#087F6D" android:maxLines="2" />
        <TextView android:id="@+id/widget_reset" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/widget_import_hint" android:textSize="12sp" android:lineSpacingExtra="6dp" android:textColor="#47675C" android:maxLines="2" />
    </LinearLayout>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_unconfigured" android:textSize="11sp" android:textColor="#6D7772" android:layout_marginTop="5dp" android:maxLines="2" />
</LinearLayout>
