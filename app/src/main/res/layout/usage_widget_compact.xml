<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_compact_background" android:clipToOutline="true" android:layoutDirection="ltr">
    <FrameLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false" android:importantForAccessibility="no">
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <ImageView android:id="@+id/widget_watermark" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center" android:src="@drawable/ic_widget_gpt_watermark" android:scaleType="fitCenter" android:importantForAccessibility="no" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false" android:paddingStart="8dp" android:paddingEnd="6dp" android:paddingTop="8dp" android:paddingBottom="8dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:baselineAligned="false">
                <LinearLayout android:id="@+id/widget_primary_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                    <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_widget_clock" android:importantForAccessibility="no" />
                    <FrameLayout android:layout_width="34dp" android:layout_height="match_parent" android:layout_marginStart="4dp">
                        <TextView android:id="@+id/widget_primary_value" android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/widget_unknown" android:textColor="@color/widget_text" android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" />
                    </FrameLayout>
                    <TextView android:id="@+id/widget_primary_countdown" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="4dp" android:text="@string/widget_unknown" android:textColor="@color/widget_muted" android:textSize="9sp" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" android:gravity="end|center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="1sp" />
                </LinearLayout>
                <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_divider" android:importantForAccessibility="no" />
                <LinearLayout android:id="@+id/widget_weekly_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                    <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_widget_calendar" android:importantForAccessibility="no" />
                    <FrameLayout android:layout_width="34dp" android:layout_height="match_parent" android:layout_marginStart="4dp">
                        <TextView android:id="@+id/widget_weekly_value" android:layout_width="match_parent" android:layout_height="match_parent" android:text="@string/widget_unknown" android:textColor="@color/widget_text" android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" />
                    </FrameLayout>
                    <TextView android:id="@+id/widget_weekly_countdown" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="4dp" android:text="@string/widget_unknown" android:textColor="@color/widget_muted" android:textSize="9sp" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" android:gravity="end|center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="1sp" />
                </LinearLayout>
            </LinearLayout>
            <ImageView android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_marginEnd="3dp" android:background="@color/widget_divider" android:importantForAccessibility="no" />
            <FrameLayout android:layout_width="24dp" android:layout_height="match_parent" />
        </LinearLayout>
        <TextView android:id="@+id/widget_status" android:layout_width="30dp" android:layout_height="12dp" android:layout_gravity="end|bottom" android:layout_marginEnd="3dp" android:layout_marginBottom="7dp" android:textColor="@color/widget_muted" android:textSize="7sp" android:includeFontPadding="false" android:maxLines="1" android:gravity="center" android:ellipsize="end" android:visibility="gone" />
    </FrameLayout>
    <ImageView android:id="@+id/widget_loading_overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no" />
    <FrameLayout android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|center_vertical" android:paddingStart="22dp" android:paddingEnd="10dp" android:paddingTop="16dp" android:paddingBottom="16dp" android:contentDescription="@string/widget_refresh_description">
        <ImageView android:id="@+id/widget_refresh_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_widget_refresh" android:importantForAccessibility="no" />
        <FrameLayout android:id="@+id/widget_refresh_animation" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
    </FrameLayout>
</FrameLayout>
