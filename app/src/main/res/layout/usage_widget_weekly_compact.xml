<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_compact_background" android:layoutDirection="ltr">
    <LinearLayout android:baselineAligned="false" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <LinearLayout android:baselineAligned="false" android:layout_width="match_parent" android:layout_height="16dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="0dp" android:paddingEnd="26dp">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_widget_gpt" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:textColor="@color/widget_text" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:text="@string/widget_title" android:gravity="center_vertical" android:layout_marginStart="4dp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:baselineAligned="false" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="center_vertical">
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="@color/widget_weekly" android:textSize="25sp" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:text="@string/widget_unknown" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="25sp" android:autoSizeStepGranularity="1sp" android:id="@+id/widget_weekly_value" android:textStyle="bold" android:gravity="center_vertical" />
                <ImageView android:id="@+id/widget_weekly_loading_value" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerInside" android:visibility="gone" android:importantForAccessibility="no" />
            </FrameLayout>
            <LinearLayout android:baselineAligned="false" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.25" android:layout_marginStart="6dp" android:orientation="vertical" android:gravity="center_vertical">
                <TextView android:layout_width="match_parent" android:layout_height="14dp" android:textColor="@color/widget_muted" android:textSize="9sp" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:text="@string/widget_weekly_remaining" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="1sp" android:gravity="center_vertical" />
                <TextView android:layout_width="match_parent" android:layout_height="16dp" android:textColor="@color/widget_muted" android:textSize="9sp" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:text="@string/widget_unknown" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="1sp" android:id="@+id/widget_weekly_countdown" android:gravity="center_vertical" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end" android:src="@drawable/ic_widget_refresh" android:padding="15dp" android:contentDescription="@string/widget_refresh_description" />
    <TextView android:layout_width="32dp" android:layout_height="10dp" android:textColor="@color/widget_muted" android:textSize="7sp" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:id="@+id/widget_status" android:visibility="gone" android:ellipsize="end" android:layout_gravity="top|end" android:layout_marginTop="37dp" android:layout_marginEnd="6dp" android:gravity="center" />
</FrameLayout>
