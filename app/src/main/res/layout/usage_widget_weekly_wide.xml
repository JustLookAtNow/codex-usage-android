<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background" android:layoutDirection="ltr">
    <LinearLayout android:baselineAligned="false" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="34dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <LinearLayout android:baselineAligned="false" android:layout_width="34dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_widget_gpt" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_text" android:textSize="9sp" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:text="@string/widget_title" android:layout_marginTop="3dp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="7sp" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:id="@+id/widget_status" android:visibility="gone" android:ellipsize="end" android:gravity="center" />
        </LinearLayout>
        <ImageView android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/widget_divider" android:importantForAccessibility="no" android:layout_marginStart="7dp" android:layout_marginEnd="7dp" />
        <LinearLayout android:baselineAligned="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="13dp" android:textColor="@color/widget_muted" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:text="@string/widget_weekly_remaining" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <ImageView android:id="@+id/widget_weekly_ring" android:contentDescription="@string/widget_weekly_remaining" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="yes" android:visibility="gone" />
                <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="@color/widget_weekly" android:textSize="28sp" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:text="@string/widget_unknown" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" android:id="@+id/widget_weekly_value" android:textStyle="bold" android:gravity="center_vertical" />
                <ImageView android:id="@+id/widget_weekly_loading_value" android:layout_width="wrap_content" android:layout_height="match_parent" android:scaleType="centerInside" android:visibility="gone" android:importantForAccessibility="no" />
            </FrameLayout>
            <ImageView android:id="@+id/widget_weekly_progress" android:layout_width="match_parent" android:layout_height="4dp" android:scaleType="fitXY" android:importantForAccessibility="no" android:layout_marginTop="3dp" android:layout_marginBottom="2dp" />
        </LinearLayout>
        <ImageView android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/widget_divider" android:importantForAccessibility="no" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" />
        <LinearLayout android:baselineAligned="false" android:layout_width="0dp" android:layout_weight="1.4" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
            <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_widget_calendar" android:importantForAccessibility="no" android:layout_marginBottom="3dp" />
            <TextView android:layout_width="match_parent" android:layout_height="15dp" android:textColor="@color/widget_muted" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:text="@string/widget_unknown" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:id="@+id/widget_weekly_countdown" android:textStyle="bold" android:gravity="center_vertical" />
            <TextView android:layout_width="match_parent" android:layout_height="14dp" android:textColor="@color/widget_muted" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="8sp" android:autoSizeStepGranularity="1sp" android:id="@+id/widget_updated_at" android:gravity="center_vertical" />
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|center_vertical" android:src="@drawable/ic_widget_refresh" android:padding="15dp" android:contentDescription="@string/widget_refresh_description" />
</FrameLayout>
