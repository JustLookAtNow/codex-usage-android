<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:clipToOutline="true" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background" android:layoutDirection="ltr">
    <FrameLayout android:id="@+id/widget_glass_blur" android:layout_width="match_parent" android:layout_height="match_parent" android:tag="OplusBlurBg" android:visibility="gone" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/widget_low_quota_glow" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:importantForAccessibility="no" android:background="@drawable/widget_low_quota_glow" />
    <FrameLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:baselineAligned="false" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="64dp" android:paddingTop="8dp" android:paddingBottom="8dp">
            <LinearLayout android:baselineAligned="false" android:layout_width="34dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_widget_gpt" android:importantForAccessibility="no" android:id="@+id/widget_icon_gpt" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_text" android:textSize="9sp" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:text="@string/widget_title" android:layout_marginTop="3dp" android:textStyle="bold" android:id="@+id/widget_static_text_1" />
            </LinearLayout>
            <ImageView android:id="@+id/widget_divider_1" android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/widget_divider" android:importantForAccessibility="no" android:layout_marginStart="7dp" android:layout_marginEnd="7dp" />
            <LinearLayout android:baselineAligned="false" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="13dp" android:textColor="@color/widget_muted" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:text="@string/widget_weekly_remaining" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:id="@+id/widget_static_muted_1" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                    <ImageView android:id="@+id/widget_weekly_ring" android:contentDescription="@string/widget_weekly_remaining" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="yes" android:visibility="gone" />
                    <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:textColor="@color/widget_weekly" android:textSize="28sp" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:text="@string/widget_unknown" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" android:id="@+id/widget_weekly_value" android:textStyle="bold" android:gravity="center_vertical" />
                </FrameLayout>
                <ImageView android:id="@+id/widget_weekly_progress" android:layout_width="match_parent" android:layout_height="4dp" android:scaleType="fitXY" android:importantForAccessibility="no" android:layout_marginTop="3dp" android:layout_marginBottom="2dp" />
            </LinearLayout>
            <ImageView android:id="@+id/widget_divider_2" android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/widget_divider" android:importantForAccessibility="no" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" />
            <LinearLayout android:baselineAligned="false" android:layout_width="0dp" android:layout_weight="1.4" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
                <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_widget_calendar" android:importantForAccessibility="no" android:layout_marginBottom="3dp" android:id="@+id/widget_icon_calendar" />
                <TextView android:layout_width="match_parent" android:layout_height="15dp" android:textColor="@color/widget_muted" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:text="@string/widget_unknown" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:id="@+id/widget_weekly_countdown" android:textStyle="bold" android:gravity="center_vertical" />
                <TextView android:layout_width="match_parent" android:layout_height="14dp" android:textColor="@color/widget_muted" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="8sp" android:autoSizeStepGranularity="1sp" android:id="@+id/widget_updated_at" android:gravity="center_vertical" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <TextView android:id="@+id/widget_status" android:layout_width="64dp" android:layout_height="12dp" android:layout_gravity="top|end" android:layout_marginTop="34dp" android:gravity="center" android:textColor="@color/widget_muted" android:textSize="7sp" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:ellipsize="end" android:visibility="gone" />
    <TextView android:id="@+id/widget_reset_count" android:layout_width="64dp" android:layout_height="12dp" android:layout_gravity="bottom|end" android:layout_marginBottom="4dp" android:gravity="center" android:textSize="9sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="1sp" />
    <ImageView android:id="@+id/widget_loading_overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no" />
    <FrameLayout android:id="@+id/widget_open_chatgpt" android:layout_width="51dp" android:layout_height="match_parent" />
    <FrameLayout android:id="@+id/widget_refresh" android:layout_width="64dp" android:layout_height="48dp" android:layout_gravity="top|end" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="12dp" android:paddingBottom="16dp" android:contentDescription="@string/widget_refresh_description">
        <ImageView android:id="@+id/widget_refresh_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_widget_refresh" android:importantForAccessibility="no" />
        <FrameLayout android:id="@+id/widget_refresh_animation" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
    </FrameLayout>
</FrameLayout>
