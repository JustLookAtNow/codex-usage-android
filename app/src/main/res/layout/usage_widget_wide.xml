<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background" android:layoutDirection="ltr">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="10dp" android:layoutDirection="ltr" android:baselineAligned="false">
        <LinearLayout android:layout_width="42dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:baselineAligned="false">
            <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_widget_gpt" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:layout_marginTop="3dp" android:text="@string/widget_title" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="7sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:id="@+id/widget_status" android:ellipsize="end" android:visibility="gone" />
        </LinearLayout>
        <ImageView android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/widget_divider" android:layout_marginStart="7dp" android:layout_marginEnd="7dp" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:baselineAligned="false">
                <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_widget_clock" android:importantForAccessibility="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:layout_marginStart="5dp" android:text="@string/widget_period_5h" android:textStyle="bold" />
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                    <ImageView android:id="@+id/widget_primary_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:visibility="gone" />
                    <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:textSize="26sp" android:textColor="@color/widget_primary" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:id="@+id/widget_primary_value" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" android:text="@string/widget_unknown" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:textSize="26sp" android:textColor="@android:color/transparent" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:id="@+id/widget_primary_loading_value" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" android:text="@string/widget_unknown" android:textStyle="bold" android:visibility="gone" android:importantForAccessibility="no" android:shadowColor="@color/widget_primary" android:shadowRadius="6.0" android:shadowDx="0.0" android:shadowDy="0.0" />
                </FrameLayout>
                <ProgressBar android:id="@+id/widget_primary_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:progressDrawable="@drawable/widget_progress_primary" android:indeterminate="false" android:max="1000" android:progress="0" android:layout_marginTop="3dp" android:layout_marginBottom="5dp" android:visibility="visible" />
                <TextView android:layout_width="match_parent" android:layout_height="15dp" android:textSize="10sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:id="@+id/widget_primary_countdown" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:text="@string/widget_unknown" android:textStyle="bold" />
            </LinearLayout>
            <ImageView android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/widget_divider" android:layout_marginStart="7dp" android:layout_marginEnd="7dp" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:baselineAligned="false">
                <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_widget_calendar" android:importantForAccessibility="no" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:layout_marginStart="5dp" android:text="@string/widget_period_weekly" android:textStyle="bold" />
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                    <ImageView android:id="@+id/widget_weekly_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:visibility="gone" />
                    <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:textSize="26sp" android:textColor="@color/widget_weekly" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:id="@+id/widget_weekly_value" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" android:text="@string/widget_unknown" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:textSize="26sp" android:textColor="@android:color/transparent" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:id="@+id/widget_weekly_loading_value" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp" android:text="@string/widget_unknown" android:textStyle="bold" android:visibility="gone" android:importantForAccessibility="no" android:shadowColor="@color/widget_weekly" android:shadowRadius="6.0" android:shadowDx="0.0" android:shadowDy="0.0" />
                </FrameLayout>
                <ProgressBar android:id="@+id/widget_weekly_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:progressDrawable="@drawable/widget_progress_weekly" android:indeterminate="false" android:max="1000" android:progress="0" android:layout_marginTop="3dp" android:layout_marginBottom="5dp" android:visibility="visible" />
                <TextView android:layout_width="match_parent" android:layout_height="15dp" android:textSize="10sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:id="@+id/widget_weekly_countdown" android:gravity="center_vertical" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:text="@string/widget_unknown" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_widget_refresh" android:importantForAccessibility="yes" android:padding="2dp" android:layout_marginStart="2dp" android:contentDescription="@string/widget_refresh_description" android:visibility="invisible" />
    </LinearLayout>
    <ImageView android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end" android:src="@drawable/ic_widget_refresh" android:contentDescription="@string/widget_refresh_description" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="16dp" />
</FrameLayout>
