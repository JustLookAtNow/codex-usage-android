<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="4dp" android:bottom="4dp">
        <scale
            android:level="6100"
            android:scaleWidth="100%"
            android:scaleHeight="100%"
            android:scaleGravity="start|fill_vertical">
            <shape android:shape="rectangle">
                <solid android:color="@color/widget_preview_green_glow" />
                <corners android:radius="5.5dp" />
            </shape>
        </scale>
    </item>
    <item android:top="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_glass_track" />
            <corners android:radius="4.5dp" />
        </shape>
    </item>
    <item android:top="5dp" android:bottom="5dp">
        <scale
            android:level="6100"
            android:scaleWidth="100%"
            android:scaleHeight="100%"
            android:scaleGravity="start|fill_vertical">
            <shape android:shape="rectangle">
                <corners android:radius="4.5dp" />
                <gradient
                    android:angle="270"
                    android:startColor="@color/widget_progress_green_top"
                    android:centerColor="@color/widget_progress_green"
                    android:endColor="@color/widget_progress_green_bottom" />
            </shape>
        </scale>
    </item>
</layer-list>
