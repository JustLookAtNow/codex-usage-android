<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_preview_gold_glow_outer" />
            <corners android:radius="7.5dp" />
        </shape>
    </item>
    <item android:top="3.5dp" android:bottom="3.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_preview_gold_glow_inner" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:top="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="4.5dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/widget_gold_silk"
                android:centerColor="@color/widget_progress_gold"
                android:endColor="@color/widget_gold_shadow" />
            <stroke android:width="0.75dp" android:color="@color/widget_gold_silk" />
        </shape>
    </item>
</layer-list>
