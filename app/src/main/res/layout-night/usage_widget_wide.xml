<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:clipToOutline="true" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background" android:layoutDirection="ltr">
    <FrameLayout android:id="@+id/widget_glass_blur" android:layout_width="match_parent" android:layout_height="match_parent" android:tag="OplusBlurBg" android:visibility="gone" android:importantForAccessibility="no" />
    <FrameLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="10dp" android:layoutDirection="ltr" android:baselineAligned="false">
            <LinearLayout android:layout_width="42dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:baselineAligned="false">
                <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/ic_widget_gpt" android:importantForAccessibility="no" android:id="@+id/widget_icon_gpt" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:layout_marginTop="3dp" android:text="@string/widget_title" android:textStyle="bold" android:id="@+id/widget_static_text_1" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="7sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:id="@+id/widget_status" android:ellipsize="end" android:visibility="gone" />
            </LinearLayout>
            <ImageView android:id="@+id/widget_divider_1" android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/widget_divider" android:layout_marginStart="7dp" android:layout_marginEnd="7dp" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="horizontal" android:baselineAligned="false">
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:baselineAligned="false">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_widget_clock" android:importantForAccessibility="no" android:id="@+id/widget_icon_clock" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_primary" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:layout_marginStart="5dp" android:text="@string/widget_period_5h" android:textStyle="bold" android:id="@+id/widget_static_primary_1" />
                    </LinearLayout>
                    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                        <ImageView android:id="@+id/widget_primary_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="yes" android:visibility="visible" />
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:textSize="26sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:id="@+id/widget_primary_value" android:gravity="center" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" android:text="@string/widget_unknown" android:textStyle="bold" android:visibility="gone" />
                    </FrameLayout>
                    <ImageView android:id="@+id/widget_primary_progress" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="3dp" android:layout_marginBottom="5dp" android:visibility="gone" android:scaleType="fitXY" android:importantForAccessibility="no" />
                    <TextView android:layout_width="match_parent" android:layout_height="15dp" android:textSize="10sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:id="@+id/widget_primary_countdown" android:gravity="center" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:text="@string/widget_unknown" android:textStyle="bold" />
                </LinearLayout>
                <ImageView android:id="@+id/widget_divider_2" android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/widget_divider" android:layout_marginStart="7dp" android:layout_marginEnd="7dp" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:baselineAligned="false">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
                        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_widget_calendar" android:importantForAccessibility="no" android:id="@+id/widget_icon_calendar" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_weekly" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:layout_marginStart="5dp" android:text="@string/widget_period_weekly" android:textStyle="bold" android:id="@+id/widget_static_weekly_1" />
                    </LinearLayout>
                    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                        <ImageView android:id="@+id/widget_weekly_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="yes" android:visibility="visible" />
                        <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:textSize="26sp" android:textColor="@color/widget_text" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:id="@+id/widget_weekly_value" android:gravity="center" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" android:text="@string/widget_unknown" android:textStyle="bold" android:visibility="gone" />
                    </FrameLayout>
                    <ImageView android:id="@+id/widget_weekly_progress" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="3dp" android:layout_marginBottom="5dp" android:visibility="gone" android:scaleType="fitXY" android:importantForAccessibility="no" />
                    <TextView android:layout_width="match_parent" android:layout_height="15dp" android:textSize="10sp" android:textColor="@color/widget_muted" android:includeFontPadding="false" android:maxLines="1" android:fontFamily="sans-serif" android:id="@+id/widget_weekly_countdown" android:gravity="center" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:autoSizeStepGranularity="1sp" android:text="@string/widget_unknown" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_widget_refresh" android:importantForAccessibility="yes" android:padding="2dp" android:layout_marginStart="2dp" android:contentDescription="@string/widget_refresh_description" android:visibility="invisible" />
        </LinearLayout>
    </FrameLayout>
    <ImageView android:id="@+id/widget_loading_overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no" />
    <FrameLayout android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|end" android:contentDescription="@string/widget_refresh_description" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="16dp">
        <ImageView android:id="@+id/widget_refresh_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_widget_refresh" android:importantForAccessibility="no" />
        <FrameLayout android:id="@+id/widget_refresh_animation" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
    </FrameLayout>
</FrameLayout>
